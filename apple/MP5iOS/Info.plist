<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MP5录播器</string>
    <key>CFBundleDisplayName</key>
    <string>MP5录播器</string>
    <key>CFBundleIdentifier</key>
    <string>com.daliao.mp5</string>
    <key>CFBundleVersion</key>
    <string>1.0.21</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.21</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </dict>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>录制视频需要使用摄像头</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>录制视频需要使用麦克风</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>录制GPS轨迹需要定位权限</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>后台录制时需要持续定位</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>audio</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>16.0</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>导出文件需要访问相册</string>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>MP5 File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.mp5</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>public.mp5</string>
            <key>UTTypeDescription</key>
            <string>MP5 Video File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.movie</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mp5</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>video/mp5</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>